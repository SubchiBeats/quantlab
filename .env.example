# Copy to .env and fill in. NEVER commit .env (it is gitignored).
# Secrets live here and ONLY here - never in YAML configs, never in code.

# Tiingo data API key (https://www.tiingo.com - free tier). Optional:
# the Stooq adapter and CSV import need no key.
TIINGO_API_KEY=

# Phase 3 only (AI research assistant). Leave empty in Phase 1.
ANTHROPIC_API_KEY=
